<?xml version="1.0" encoding="utf-8"?>
<templates>
    <template name="常用应用操作">
        <item>
            <attr name="icon">./res/icons/app_uninstall_256x256.png</attr>
            <attr name="text">卸载应用</attr>
            <attr name="cmd" shell="false">uninstall {0}</attr>
        </item>
        <item>
            <attr name="icon">./res/icons/app_install_256x256.png</attr>
            <attr name="text">安装应用</attr>
            <attr name="cmd" shell="false">install -r {0}</attr>
        </item>
        <item>
            <attr name="icon">./res/icons/app_stop_256x256.png</attr>
            <attr name="text">停止应用</attr>
            <attr name="cmd">am force-stop {0}</attr>
        </item>
        <item>
            <attr name="icon">./res/icons/app_start_256x256.png</attr>
            <attr name="text">启动应用</attr>
            <attr name="cmd">am start {0}</attr>
        </item>
        <item>
            <attr name="icon">./res/icons/app_restart_256x256.png</attr>
            <attr name="text">重启应用</attr>
            <attr name="cmd">am start {0}</attr>
        </item>
    </template>
    <template name="快捷功能2">
        <item>
            <attr name="icon">./res/icons/app_clear_data_256x256.png</attr>
            <attr name="text">清除数据</attr>
            <attr name="cmd">pm clear {0}</attr>
        </item>
        <item>
            <attr name="icon">./res/icons/screen_capture_256x256.png</attr>
            <attr name="text">截图并保存</attr>
            <attr name="cmd">am start {0}</attr>
        </item>
        <item>
            <attr name="icon">./res/icons/app_start_256x256.png</attr>
            <attr name="text">重启应用3</attr>
            <attr name="cmd">am start {0}</attr>
        </item>
    </template>

</templates>