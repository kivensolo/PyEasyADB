<?xml version="1.0" encoding="utf-8"?>
<CMD>
    <group name="App">
        <item name="Start">am start {0}</item>
        <item name="Clear Data">pm clear {0}</item>
        <item name="Stop">am force-stop {0}</item>
        <item name="Uinstall" shell="false">adb uninstall {0}</item>
        <item name="Versions">dumpsys package {0} |grep version</item>
        <item name="CurrentFocus">dumpsys window |grep mCurrentFocus</item>
        <item name="Install Path" dst_pkg="true">pm path {0}</item>
        <item name="Get app Memory" dst_pkg="true">dumpsys meminfo {0}</item>
    </group>
    <group name="Display">
        <item name="Screenshot">【抱歉，暂未实现】</item>
        <item name="Screenrecord">【抱歉，暂未实现】</item>
        <item name="Density">wm density</item>
    </group>
    <group name="System">
        <sub_group name="Memory">
            <item name="Dump">dumpsys</item>
            <item name="Top">top -n 1</item>
        </sub_group>
        <item name="Features" desc="列出设备硬件信息">pm list features | cut -c9- | sort -u</item>
        <item name="CPU Info">cat /proc/cpuinfo</item>
    </group>
    <group name="NET">
        <citem name="Hosts">cat /etc/hosts</citem>
        <citem name="Network Info">ipconfig</citem>
        <citem name="MAC">cat /sys/class/net/eth0/address</citem>
        <citem name="iftop">cat /sys/class/net/eth0/address</citem>
    </group>
    <group name="Packages">
        <item name="All packages">pm list packages -f</item>
        <item name="Libraries">pm list libraries</item>
        <item name="Install and uninstall"/>
    </group>
    <group name="About">
        <sub_group name="ADB">
            <item name="Help" shell="false">help</item>
            <item name="Version" shell="false">version</item>
        </sub_group>
    </group>

</CMD>